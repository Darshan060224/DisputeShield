# ==============================================================================
# DisputeShield Environment Configuration Example
# Copy this file to .env and fill in your actual integration values.
# DO NOT commit plaintext secrets or production API keys to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_cookie_secret_change_in_production

# Database Configuration (MySQL / TiDB)
DATABASE_URL=mysql://root:password@localhost:3306/disputeshield

# Redis Caching (Optional - falls back to in-memory cache if omitted)
REDIS_URL=redis://localhost:6379


# Razorpay Integration Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Azure OpenAI Integration
AZURE_OPENAI_ENDPOINT=https://darshan-23csa19-0390-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5-6-luna
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Local Ollama Sentiment Analysis (Optional for local-loopback sentiment)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Platform / OAuth Environment Variables (Optional)
VITE_APP_ID=disputeshield
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=merchant_owner_001
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
